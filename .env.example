# Backend Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=plantcare-ai-super-secret-key-change-in-production

# ML Model Configuration
MODEL_PATH=ml-model/models/plant_disease_model_best.keras
CLASS_NAMES_PATH=ml-model/models/class_names.json
CONFIDENCE_THRESHOLD=0.60

# Database Persistence
USE_SQLITE_FALLBACK=true
DATABASE_PATH=backend/plantcare.db

# Firebase Configuration (Optional - Local SQLite fallback used if not provided)
FIREBASE_CREDENTIALS_PATH=backend/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-app-id.appspot.com

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

